<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-2.1.xsd">

    <entity entity-name="ContactMech" package="OnlineRetailBusinessOrg">
        <field name="contactMechId" type="id" is-pk="true"/>
        <field name="partyId" type="text-short"/>
        <field name="streetAddress" type="text-medium" not-null="true"/>
        <field name="postalCode" type="text-short"/>

        <!--        one party can have multiple contact mechs and
        multiple contact mechs only refer to a single party -->
        <relationship type="one" title="Party" related="Party">
            <key-map field-name="partyId"/>
        </relationship>
    </entity>
</entities>