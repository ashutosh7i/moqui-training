<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">


    <!--    1. create contact mech-->
    <!--    2. find contact mech-->
    <!--    3. store contact mech-->
    <!--    4. delete contact mech-->

    <!--    1. create contact mech-->
    <!--    test: OK 100052-->
    <service verb="create" noun="ContactMech" type="entity-auto">
        <in-parameters>
            <auto-parameters entity-name="ContactMech" include="nonpk"/>
            <parameter name="partyId" required="true"/>
            <parameter name="streetAddress"/>
            <parameter name="postalCode"/>
        </in-parameters>
        <out-parameters>
            <parameter name="contactMechId"/>
        </out-parameters>
    </service>

    <!--    2. get contact mech by contact mech-->
    <!--    test: OK-->
    <service verb="find" noun="ContactMech">
        <in-parameters>
            <parameter name="partyId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="foundContactMechIdList" type="list"/>
        </out-parameters>
        <actions>
            <!--    returns entity list if found, else empty list-->
            <entity-find entity-name="ContactMech" list="foundContactMechIdList">
                <econdition field-name="partyId"/>
                <select-field field-name="contactMechId"/>
                <select-field field-name="partyId"/>
                <select-field field-name="streetAddress"/>
                <select-field field-name="postalCode"/>
            </entity-find>
        </actions>
    </service>

    <!--    3. update Contact_mech -->
    <!--    test: OK-->
    <service verb="update" noun="ContactMech" type="entity-auto">
        <in-parameters>
            <auto-parameters entity-name="ContactMech" include="nonpk"/>
            <parameter name="partyId" required="true"/>
            <parameter name="contactMechId" required="true"/>
        </in-parameters>
    </service>

    <!--    4. delete ContactMech-->
    <!--    test: OK-->
    <service verb="delete" noun="ContactMech" type="entity-auto">
        <in-parameters>
            <parameter name="partyId"/>
            <parameter name="contactMechId" required="true"/>
        </in-parameters>
    </service>

</services>
